---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
import { site } from '../data/site';
import Arrow from '../components/Arrow.astro';
import Wordmark from '../components/Wordmark.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/kevin-hawkins.jpg';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2d3586" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-width flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
      <a class="wordmark-link" href="#top" aria-label="Hawkins for Schools — back to top"><Wordmark /></a>
      <nav aria-label="Main navigation">
        <ul class="header-nav flex items-center gap-6 sm:gap-10" role="list">
          <li><a href="#interview">Interview</a></li>
          <li><a href="#what-i-believe">{site.beliefsHeading}</a></li>
          <li><a href="#priorities">{site.prioritiesHeading}</a></li>
          <li><a href={`mailto:${site.feedback.email}`} aria-label="Email Kevin with thoughts, comments, or suggestions">Email Kevin</a></li>
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero page-width" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="candidate-name">{site.candidateName}</p>
          <h1 id="page-title" class="hero-title">
            <span>Hawkins</span>{' '}
            <span class="hero-title-second">for <em>Schools</em></span>
          </h1>
          <p class="candidate-role">
            <span>{site.role}</span>
            <span>{site.district}</span>
            <strong>{site.seat}</strong>
          </p>
          <div class="hero-bottom flex flex-wrap items-center gap-4">
            <a class="section-button" href="#what-i-believe">{site.beliefsHeading}<Arrow /></a>
            <a class="text-link" href="#priorities">{site.prioritiesHeading}<Arrow /></a>
          </div>
        </div>
        <div class="portrait-frame">
          <Image
            class="candidate-portrait"
            src={portrait}
            alt="Kevin Hawkins smiling in a barbershop"
            width={720}
            widths={[360, 540, 720, 1080]}
            sizes="(min-width: 1440px) 420px, (min-width: 1024px) 34vw, (min-width: 768px) 35vw, (min-width: 640px) 480px, calc(100vw - 40px)"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </section>

      <section id="interview" class="interview section-anchor page-width" aria-labelledby="interview-title" tabindex="-1">
        <div class="interview-heading">
          <div>
            <p class="video-source">{site.video.publisher}</p>
            <h2 id="interview-title">Watch the interview</h2>
          </div>
          <a class="text-link" href={`https://www.youtube.com/watch?v=${site.video.id}`}>
            Watch on YouTube<span aria-hidden="true">↗</span>
          </a>
        </div>
        <iframe
          class="video-player"
          src={`https://www.youtube-nocookie.com/embed/${site.video.id}?rel=0`}
          title={site.video.title}
          width="960"
          height="540"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </section>

      <section id="what-i-believe" class="beliefs section-anchor" aria-labelledby="beliefs-title" tabindex="-1">
        <div class="page-width beliefs-layout grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div class="section-heading">
            <span class="section-index" aria-hidden="true">01</span>
            <h2 id="beliefs-title">What I <em>believe</em></h2>
            <div class="heading-rule" aria-hidden="true"></div>
          </div>
          <div class="belief-list">
            {site.beliefs.map((belief, index) => (
              <article class="belief">
                <span class="belief-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{belief.title}</h3>
                  <p>{belief.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="priorities" class="priorities section-anchor page-width" aria-labelledby="priorities-title" tabindex="-1">
        <div class="priorities-heading flex items-baseline gap-6 sm:gap-10">
          <span class="section-index" aria-hidden="true">02</span>
          <h2 id="priorities-title">{site.prioritiesHeading}</h2>
        </div>
        <ol class="priority-list grid md:grid-cols-2" role="list">
          {site.priorities.map((priority, index) => (
            <li class="priority flex items-start gap-6 sm:gap-8">
              <span class="priority-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p>{priority}</p>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="site-footer page-width flex flex-wrap items-center justify-between gap-8">
      <a class="wordmark-link" href="#top" aria-label="Hawkins for Schools — back to top"><Wordmark /></a>
      <div class="footer-links flex flex-wrap items-center gap-x-8 gap-y-3">
        <a class="text-link feedback-link" href={`mailto:${site.feedback.email}`} aria-label={`${site.feedback.label} — email Kevin`}>
          <span>{site.feedback.label}</span><span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#top">Back to top<Arrow direction="up" /></a>
      </div>
    </footer>
  </body>
</html>
